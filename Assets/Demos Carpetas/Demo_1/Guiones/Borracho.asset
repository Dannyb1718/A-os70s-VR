MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2a81eae8aa2b1f047bdf0addc8332c99, type: 3}
  m_Name: Borracho
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  npcName: Lucho
  openingLines:
  - 'EHHHHHH JUAN, PELAO!!!!!

    Ya se sienten las fiestas en el pueblo.'
  choices:
  - choiceText: "\xBFEst\xE1 bien?"
    isExitChoice: 0
    animationTrigger: Drunk_Idle
    responseLines:
    - "\xBFYo? \xA1Perfectamente bien, mijo! Aqu\xED donde me ve, firme como un roble\u2026
      bueno, un roble que se mueve un poquito, pero firme."
    - " Es que estas fiestas no son todos los d\xEDas, \xBFs\xED me entiende? Uno
      trabaja duro todo el a\xF1o, as\xED que cuando llega el momento, hay que celebrar
      como se debe."
    - "No se preocupe por m\xED, que yo s\xE9 llegar a mi casa\u2026 creo."
  - choiceText: "\xBFHa visto la procesi\xF3n?"
    isExitChoice: 0
    animationTrigger: 
    responseLines:
    - "\xA1Claro, mijo! Eso ya lo tienen todo preparado, aunque todav\xEDa no ha
      salido. La gente anda arreglando las calles y dejando todo bonito pa\u2019
      cuando pase el santo. Yo digo que este a\xF1o va a estar bien llena, como en
      los viejos tiempos. \n\nA ver si esta vez la veo completica\u2026 y no como
      otras veces que me distraigo por ah\xED."
